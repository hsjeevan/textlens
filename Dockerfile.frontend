# syntax=docker/dockerfile:1

# React dashboard (frontend/). Built with Vite, then served by nginx, which also
# proxies /api/* to the API at TEXTLENS_API_URL.

# --- Stage 1: build the static bundle ----------------------------------------
FROM node:24-alpine AS build
WORKDIR /src
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

# --- Stage 2: serve it -------------------------------------------------------
# The unprivileged image runs as uid 101 and keeps its pid and temp files in /tmp.
FROM nginxinc/nginx-unprivileged:1.29-alpine

ENV TEXTLENS_API_URL=http://localhost:8000
# Only substitute our variable; nginx's own $vars must be left alone.
ENV NGINX_ENVSUBST_FILTER=TEXTLENS_API_URL

USER root
RUN rm -f /etc/nginx/conf.d/default.conf
USER 101

COPY frontend/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /src/dist /usr/share/nginx/html

EXPOSE 8080
